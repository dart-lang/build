import 'contracts.dart';

class Calculator {
  @Requires('x > 0')
  @Requires('y > 0')
  int add(int x, int y) {
    if (!Contracts.checking) {
      Contracts.checking = true;
      try {
        if (!(x > 0)) throw ContractViolation('Precondition failed: x > 0');
        if (!(y > 0)) throw ContractViolation('Precondition failed: y > 0');
      } finally {
        Contracts.checking = false;
      }
    }

    return x + y;
  }

  @Requires('x >= 0')
  int half(int x) {
    if (!Contracts.checking) {
      Contracts.checking = true;
      try {
        if (!(x >= 0)) throw ContractViolation('Precondition failed: x >= 0');
      } finally {
        Contracts.checking = false;
      }
    }
    return x ~/ 2;
  }
}
