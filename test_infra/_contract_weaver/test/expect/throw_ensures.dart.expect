import 'contracts.dart';

class Queue {
  final List<int> _items = [];

  @ThrowEnsures(StateError, '_items.isEmpty')
  @ThrowEnsures(StateError, 'signal.message == "empty"')
  @ThrowEnsures(ArgumentError, 'index < 0 || index >= _items.length')
  int take(int index) {
    try {
      if (_items.isEmpty) throw StateError('empty');
      if (index < 0) throw ArgumentError.value(index);
      return _items.removeAt(index);
    } on StateError catch (signal) {
      if (!Contracts.checking) {
        Contracts.checking = true;
        try {
          if (!(_items.isEmpty))
            throw ContractViolation(
              'Exceptional postcondition failed: _items.isEmpty',
            );
          if (!(signal.message == "empty"))
            throw ContractViolation(
              'Exceptional postcondition failed: signal.message == "empty"',
            );
        } finally {
          Contracts.checking = false;
        }
      }
      rethrow;
    } on ArgumentError catch (signal) {
      if (!Contracts.checking) {
        Contracts.checking = true;
        try {
          if (!(index < 0 || index >= _items.length))
            throw ContractViolation(
              'Exceptional postcondition failed: index < 0 || index >= _items.length',
            );
        } finally {
          Contracts.checking = false;
        }
      }
      rethrow;
    }
  }
}
