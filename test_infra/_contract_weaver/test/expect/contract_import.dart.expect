// The clause uses an extension that this library does not import.
@ContractImport('package:p/src/strings.dart')
library;

import 'package:p/src/strings.dart';

import 'contracts.dart';

class Editor {
  @Requires('text.isNotBlank')
  void edit(String text) {
    if (!Contracts.checking) {
      Contracts.checking = true;
      try {
        if (!(text.isNotBlank))
          throw ContractViolation('Precondition failed: text.isNotBlank');
      } finally {
        Contracts.checking = false;
      }
    }
  }
}
